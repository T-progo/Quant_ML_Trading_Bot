# Copy this file to ".env" and fill in your real values.
# Get Binance TESTNET keys from https://testnet.binance.vision/ (login with GitHub)

BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here

SYMBOL=BTC/USDT
TIMEFRAME=15m
TRADE_AMOUNT_USDT=50
PAPER_STARTING_BALANCE=1000

# Only needed for execution/live_trader.py --real-account (trading real money).
# Leave unset/blank until you have actually decided to risk real funds - this
# is one of three independent checks that all must pass (see live_trader.py).
CONFIRM_REAL_MONEY_TRADING=
